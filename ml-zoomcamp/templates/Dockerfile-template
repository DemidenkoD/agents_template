# Multi-stage production container for Streamlit / Python inference app
FROM python:3.11-slim AS builder

WORKDIR /app

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv

COPY pyproject.toml uv.lock ./
RUN /uv/bin/uv sync --frozen --no-cache

COPY src/ ./src/
COPY app/ ./app/
COPY models/ ./models/

EXPOSE 8501

ENTRYPOINT ["/uv/bin/uv", "run", "streamlit", "run", "app/app.py", "--server.port=8501", "--server.address=0.0.0.0"]

